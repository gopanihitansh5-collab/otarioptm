# Otari hosted gateway key (enables live model routing + real usage/cost data)
OTARI_API_KEY=

# Groq free-tier key (fallback chain tier when Otari is unavailable)
GROQ_API_KEY=

# Exa key (semantic web search powering the Web Search workflow node)
EXA_API_KEY=

# Resend key (fires the budget-cap alert email when the cap blocks a run)
RESEND_API_KEY=

# Inbox for budget-cap alert emails
BUDGET_ALERT_EMAIL=

# Optional: path to config YAML (defaults to config/config.yml)
OTARIOPTM_CONFIG=
