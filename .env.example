# OtariOptm environment template.
#
# Copy to .env (never commit it - .gitignore and .dockerignore exclude it) and
# fill in only what you have. Every key below is OPTIONAL: with none of them
# set the gateway boots in zero-key demo mode, returns deterministic responses
# and never spends money. No value in this file is a real secret.

# --- Optional: live model providers -----------------------------------------

# Otari hosted gateway key (enables live model routing + real usage/cost data)
# Read at src/gateway/main.py:76 and src/services/otari_client.py:65
OTARI_API_KEY=

# Groq free-tier key (fallback chain tier when Otari is unavailable)
# Read at src/gateway/main.py:82
GROQ_API_KEY=

# Exa key (semantic web search powering the Web Search workflow node)
# Read at src/gateway/main.py:339 and src/services/search.py:42
EXA_API_KEY=

# Resend key (fires the budget-cap alert email when the cap blocks a run)
# Read at src/gateway/main.py:421
RESEND_API_KEY=

# Inbox for budget-cap alert emails
# Read at src/gateway/main.py:422 (used only together with RESEND_API_KEY)
BUDGET_ALERT_EMAIL=

# --- Optional: configuration ------------------------------------------------

# Optional: path to the config YAML the gateway loads at startup
# (src/services/budget.py:43). Default: config/config.yml
# Inside the Docker image the file is /app/config/config.yml.
OTARIOPTM_CONFIG=

# Optional: public base URL of the gateway, used by the web app in the browser
# (web/src/lib/api.ts:10, web/src/lib/landing/Reveal.tsx:135).
# Default: http://localhost:8000
# NOTE: Next.js inlines NEXT_PUBLIC_* at BUILD time, so for Docker this must be
# passed as a build arg (see docker-compose.yml -> web.build.args).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# Optional: comma-separated CORS allow-list for the gateway.
# NOTE: the gateway still hardcodes its allow-list today
# (src/gateway/main.py:1005-1009), so this variable is inert until that read
# is wired; the default below mirrors the built-in list.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
